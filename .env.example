# Website to monitor (read-only checks only)
SITE_URL=https://lnct.ac.in

# Google Gemini Developer API: https://aistudio.google.com/apikey
# Uses the current Gemini 3.8 Flash model by default.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Google Cloud API key with PageSpeed Insights API enabled (optional but recommended).
# Update PAGESPEED_API_KEY when replacing an expired key; keep it server-side.
PAGESPEED_API_KEY=
# PageSpeed Insights first-attempt timeout in milliseconds (30,000–120,000). Default 75,000.
PAGESPEED_TIMEOUT_MS=75000

# Protects the scheduled daily scan endpoint. Set a strong random value in deployment.
CRON_SECRET=

# Supabase project URL + server-only secret/service-role key
# Use the project root URL (do not append /rest/v1/).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Required in production; comma-separated valid email addresses. Empty or malformed values deny dashboard access.
DASHBOARD_ALLOWED_EMAILS=

# Critical issue alerts (Resend: https://resend.com)
# Optional. Use a sender address/domain verified in your Resend account.
RESEND_API_KEY=
ALERT_EMAIL_TO=
ALERT_EMAIL_FROM="Website Monitor AI <alerts@your-verified-domain.com>"
